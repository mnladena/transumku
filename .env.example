# Web Push (notifications while the app is closed). Generate keys: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can reach you at (mailto: or https: URL).
VAPID_SUBJECT=mailto:you@example.com
# Random string; the cron must send "Authorization: Bearer <CRON_SECRET>" to /api/push/cron.
CRON_SECRET=
# Upstash Redis (Vercel → Storage → Upstash). Either pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
